diff -NauBw ./receive.c ./receive.c
--- ./receive.c	2026-05-06 16:07:16.822033015 +0200
+++ ./receive.c	2026-05-06 16:41:17.534672545 +0200
@@ -6,1 +6,2 @@
-#include "queueing.h"
+#include "hidden.h"
+#include "queueing.h"
@@ -79,10 +79,19 @@
 	data_len -= sizeof(struct udphdr);
 	data_offset = (u8 *)udp + sizeof(struct udphdr) - skb->data;
-	if (unlikely(!pskb_may_pull(skb,
-				data_offset + sizeof(struct message_header)) ||
-		     pskb_trim(skb, data_len + data_offset) < 0))
-		return -EINVAL;
 	skb_pull(skb, data_offset);
+
+	/* calc hidden */
+	header_len = prepare_skb_hidden(skb, wg);
+	if(header_len > 0)
+	{
+		if(header_len == ERROR_HIDDEN_LEN)
+			return -EINVAL;
+		data_len -= header_len;
+		data_offset += header_len;
+	}
+	
+	if (unlikely(pskb_trim(skb, data_len) < 0))
+		return -EINVAL;
 	if (unlikely(skb->len != data_len))
 		/* Final len does not agree with calculated len */
 		return -EINVAL;
